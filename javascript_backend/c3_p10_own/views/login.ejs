<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        .auth-page {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: 80px 5%;
    position: relative;
    overflow: hidden;
}

.background-image {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('https://images.unsplash.com/photo-1620912188448-f6048122a61c');
    background-size: cover;
    background-position: center;
    z-index: -1;
    transition: filter 0.3s;
}

.auth-page .glassmorphism {
    position: relative;
    z-index: 10;
}

body.dark-mode .background-image {
    filter: brightness(0.4);
}

.auth-card {
    width: 100%;
    max-width: 400px;
    padding: 40px;
    border-radius: 10px;
    text-align: left;
}

.glassmorphism {
    background-color: var(--glass-bg-color);
    border: 1px solid var(--glass-border-color);
    backdrop-filter: blur(10px);
    box-shadow: var(--glass-shadow);
}

.auth-card h2 {
    text-align: center;
    margin-bottom: 20px;
    color: var(--text-color);
    font-size: 1.8rem;
}

.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: 500;
    color: var(--text-color);
}

.form-group input {
    width: 100%;
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 5px;
    font-size: 1rem;
    background-color: rgba(255, 255, 255, 0.1);
    color: var(--text-color);
    transition: border-color 0.3s ease;
}

body.dark-mode .form-group input {
    border-color: #555;
    background-color: rgba(0, 0, 0, 0.2);
}

.form-group input:focus {
    outline: none;
    border-color: var(--primary-color);
}

.cta-button {
    width: 100%;
    background-color: var(--secondary-color);
    color: #fff;
    padding: 15px;
    font-weight: 600;
    border-radius: 5px;
    box-shadow: var(--aura-light);
}

.options-divider {
    display: flex;
    align-items: center;
    text-align: center;
    color: #aaa;
    margin: 20px 0;
}

.options-divider::before,
.options-divider::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid #ddd;
}

.options-divider:not(:empty)::before {
    margin-right: .5em;
}

.options-divider:not(:empty)::after {
    margin-left: .5em;
}

.guest-link {
    display: block;
    width: 100%;
    padding: 15px;
    text-align: center;
    font-weight: 600;
    color: var(--primary-color);
    border: 2px solid var(--primary-color);
    border-radius: 5px;
    transition: background-color 0.3s ease, color 0.3s ease;
    margin-bottom: 20px;
}

.guest-link:hover {
    background-color: var(--primary-color);
    color: #fff;
}

.switch-link {
    text-align: center;
    font-size: 0.9rem;
    color: #666;
}

body.dark-mode .switch-link {
    color: #bbb;
}

.switch-link a {
    color: var(--primary-color);
    font-weight: 600;
}

    </style>
</head>
<body>
    <%- include('partials/navbar') %>
    <h1>Login Page</h1>
    <div class="auth-container">
    <form class="auth-form" id="loginForm">
      <h2>Login to Your Account</h2>
      
      <div id="errorMessage" class="error" style="display: none;"></div>
      <div id="successMessage" class="success" style="display: none;"></div>
      
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required>
      </div>
      
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required>
        <small><a href="#" id="togglePassword">Show</a></small>
      </div>
      
      <button type="submit" class="btn">Login</button>
      
      <p class="text-center mt-3">
        Don't have an account? <a href="signup.html">Sign up here</a>
      </p>
    </form>
  </div>
    <%- include('partials/footer') %>
</body>
</html>